{
  "configs": [
    {
      "title": "ReplayGain",
      "config": "config.json",
      "preferences": [
        {
          "key": "replaygain.referenceLoudness",
          "type": "edittext",
          "title": "参考响度 (LUFS)",
          "summary": "范围 -30.0 ~ 0.0，保留 1 位小数",
          "default_value": "-18.0"
        },
        {
          "key": "replaygain.ffmpegPath",
          "type": "edittext",
          "title": "FFmpeg 路径",
          "summary": "填写 ffmpeg 可执行文件或其所在目录的绝对路径；留空则自动使用 PATH 或环境变量 FFMPEG_PATH",
          "default_value": ""
        },
        {
          "key": "replaygain.autoIndexOnStart",
          "type": "switch",
          "title": "启动时自动补扫未索引歌曲",
          "summary": "插件启用后自动测量并写入尚未索引的曲目",
          "default_value": false
        },
        {
          "key": "replaygain.writeTags",
          "type": "switch",
          "title": "将结果写入文件标签",
          "summary": "关闭后仅测量并记录到数据库，不修改音频文件",
          "default_value": true
        }
      ]
    },
    {
      "title": "索引操作",
      "config": "config.json",
      "preferences": [
        {
          "type": "button",
          "title": "索引全部歌曲",
          "summary": "测量并写入所有尚未索引的歌曲（需要系统已安装 FFmpeg）",
          "arrow_type": "none",
          "on_click": "com.alierkitten.spw.replaygain.MainPlugin.onIndexAllButtonClick"
        },
        {
          "type": "button",
          "title": "重新全量索引",
          "summary": "重新测量并写入曲库中的每一首歌曲，忽略已有的索引记录（用于修正错误数据，需要 FFmpeg）",
          "arrow_type": "none",
          "on_click": "com.alierkitten.spw.replaygain.MainPlugin.onReindexAllButtonClick"
        },
        {
          "type": "button",
          "title": "索引当前播放歌曲",
          "summary": "仅处理当前正在播放的歌曲",
          "arrow_type": "none",
          "on_click": "com.alierkitten.spw.replaygain.MainPlugin.onIndexCurrentButtonClick"
        },
        {
          "type": "button",
          "title": "清理歌曲增益标签",
          "summary": "移除所有歌曲文件中的 ReplayGain 增益标签（REPLAYGAIN_TRACK_GAIN / TRACK_PEAK / REFERENCE_LOUDNESS），无需 FFmpeg",
          "arrow_type": "none",
          "on_click": "com.alierkitten.spw.replaygain.MainPlugin.onCleanupReplayGainTagsButtonClick"
        }
      ]
    }
  ]
}
